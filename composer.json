{
    "name": "kipchak/driver-memcached",
    "type": "middleware",
    "description": "A Kipchak Memcached driver (dependency) for the Kipchak API Development Kit (ADK)",
    "keywords": [
        "APIs",
        "Memcached",
        "Microservices",
        "Mamluk"
    ],
    "homepage": "https://mamluk.net",
    "license": "MIT",
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Kipchak\\Driver\\Memcached\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "symfony/cache": "^6.4",
        "kipchak/core": "2.x-dev",
        "kipchak/driver-config": "dev-master",
        "ext-memcached": "*"
    }
}
