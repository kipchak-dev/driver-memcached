{
    "name": "kipchak/driver-memcached",
    "type": "middleware",
    "description": "A Kipchak Memcached driver (dependency) for the Kipchak API Development Kit (ADK)",
    "keywords": [
        "APIs",
        "Memcached",
        "Microservices",
        "Mamluk"
    ],
    "homepage": "https://mamluk.net",
    "license": "MIT",
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Kipchak\\Driver\\Memcached\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kipchak\\Driver\\Memcached\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "symfony/cache": "^8",
        "kipchak/core": "^2 || ^3",
        "kipchak/driver-config": "^1",
        "ext-memcached": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12"
    },
    "extra": {
        "kipchak": {
            "type": "driver",
            "config": "sample.config.php",
            "configName": "kipchak.memcached.php",
            "initialise": "\\Kipchak\\Driver\\Memcached\\Memcached::initialise($container);",
            "after": [
                "kipchak/driver-config",
                "kipchak/driver-logger"
            ],
            "before": [],
            "docs": "https://kipchak.dev/docs/driver-memcached"
        }
    }
}
